<Window x:Class="BettyTranslate.App.Views.UpdateConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
    <Border CornerRadius="14" Background="#FFFFFF"
            BorderBrush="#CFCFCF" BorderThickness="1"
            MinWidth="440" MaxWidth="480">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.28" Color="#101010" />
        </Border.Effect>
        <StackPanel>
            <!-- 顶部横幅：绿色渐变 + 图标 + 标题 -->
            <Border Height="52" CornerRadius="14,14,0,0" Padding="20,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1F9D55" Offset="0" />
                        <GradientStop Color="#2FBE6E" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/AppIcon.ico" Width="22" Height="22"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Betty Translate" FontSize="15" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="应用更新" FontSize="12" Foreground="#D7F2E3"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 主体区域 -->
            <Border Padding="24,20,24,22">
                <StackPanel>
                    <!-- 版本信息 -->
                    <Border Background="#EAF7F0" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="准备更新到" FontSize="15" Foreground="#2F7D52" VerticalAlignment="Center" />
                                <TextBlock x:Name="VersionText" FontSize="20" FontWeight="Bold" Foreground="#1B1B1B"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="AssetText" FontSize="12" Foreground="#5C7A69"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="已下载新版本，是否立即应用并重启软件？"
                               FontSize="13.5" Foreground="#3A3A3A" TextWrapping="Wrap" Margin="0,0,0,18" />

                    <!-- 按钮区：暂不更新=浅灰，立即重启=绿色 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="LaterButton" IsCancel="True" Click="OnLaterClick"
                                Height="36" MinWidth="120" Padding="16,0" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="#555555" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#EFEFEF" CornerRadius="7"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#E3E3E3" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#D6D6D6" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="暂不更新" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                        </Button>

                        <Button x:Name="ApplyButton" IsDefault="True" Click="OnApplyClick"
                                Height="36" MinWidth="150" Padding="16,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#1F9D55" CornerRadius="7"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#1A8748" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#16703C" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="立即更新并重启" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
