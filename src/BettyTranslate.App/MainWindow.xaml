<Window x:Class="BettyTranslate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Betty Translate" Height="680" Width="1100"
        MinWidth="880" MinHeight="560"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">
    <Window.Resources>
        <!-- 功能导航按钮（hover 浅灰） -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 选中态导航按钮：浅蓝底 + 蓝色加粗文字 + 左侧色条 -->
        <Style x:Key="NavButtonSelected" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="AccentBar" Width="3" Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Left" CornerRadius="1.5" Margin="0,8,0,8" />
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 底部操作按钮（图标 + 文字） -->
        <Style x:Key="BottomNavButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BottomHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BottomPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏（浅色） -->
        <Border Grid.Column="0" Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌区 -->
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/AppIcon.ico"
                           Width="32" Height="32" VerticalAlignment="Center" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Betty Translate" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="betty屏幕翻译" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 功能区（白色卡片，醒目） -->
                <Border Grid.Row="1" Margin="0,24,0,0" Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8" Padding="8"
                        BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="功能" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="12,6,0,8" />
                        <Button x:Name="NavTranslateBtn" Style="{StaticResource NavButtonSelected}" Click="OnNavTranslateClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="屏幕截屏翻译" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavImageBtn" Style="{StaticResource NavButton}" Margin="0,4,0,0"
                                Click="OnNavImageTranslateClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="图片翻译" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSelectionBtn" Style="{StaticResource NavButton}" Margin="0,4,0,0"
                                Click="OnNavSelectionTranslateClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="划词翻译" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="8,10,8,10" />

                        <Button x:Name="NavSettingsBtn" Style="{StaticResource NavButton}" Click="OnNavSettingsClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="设置" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 底部操作 -->
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0,0,0,10" />
                    <Button Style="{StaticResource BottomNavButton}" Click="OnOfficialUrlClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="官方网址" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BottomNavButton}" Click="OnLogoutClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="退出登录" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧内容区（白色表面） -->
        <Grid Grid.Column="1" Background="{DynamicResource SurfaceBrush}">

            <!-- 翻译功能页 -->
            <Grid x:Name="TranslateView" Margin="44,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="屏幕截屏翻译" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="抬起全局快捷键，框选屏幕上的英文区域，即可悬浮覆盖中文译文"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
                    <!-- 发现新版本时显示：点击「前往更新」跳转到设置页更新区 -->
                    <Border x:Name="UpdateBanner" Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="8" Padding="16,12" Margin="0,16,0,0" Visibility="Collapsed"
                            BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UpdateBannerText" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button x:Name="UpdateBannerBtn" Content="前往更新" FontSize="12" FontWeight="SemiBold"
                                    Padding="16,6" Margin="16,0,0,0" Background="{DynamicResource AccentBrush}"
                                    Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Click="OnUpdateBannerClick" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="560">
                        <!-- 功能一：屏幕截屏翻译 -->
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="24,22"
                                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="屏幕截屏翻译" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="框选英文区域，识别并翻译为中文，悬浮文字框覆盖显示在原位置"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,6,0,16" />

                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="12,10"
                                        BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="10,4"
                                                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                                            <TextBlock x:Name="ModifierKeyText" Text="Ctrl" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                        <TextBlock Text=" + " FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="8,0" />
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="10,4"
                                                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                                            <TextBlock x:Name="MainKeyText" Text="F10" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                        <TextBlock Text="框选要翻译的区域" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                    <Button x:Name="StartButton" Content="开始使用" FontSize="14" FontWeight="SemiBold"
                                            Padding="26,9" Background="{DynamicResource AccentBrush}" Foreground="White"
                                            BorderThickness="0" Cursor="Hand" Click="OnStartClick" />
                                    <Button x:Name="EndButton" Content="结束" FontSize="13" Margin="12,0,0,0"
                                            Padding="22,9" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                                            Cursor="Hand" Visibility="Collapsed" Click="OnEndClick" />
                                </StackPanel>

                                <TextBlock x:Name="StatusText"
                                           Text="点击「开始使用」后，按 Ctrl+F10 框选屏幕上的英文区域"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,14,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 图片翻译页 -->
            <Grid x:Name="ImageTranslateView" Margin="44,36" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="图片翻译" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="抬起全局快捷键，框选屏幕上的英文区域，生成英文被中文替换的新图片，可保存或复制"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="560">
                        <!-- 图片翻译 -->
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="24,22"
                                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="图片翻译" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="框选区域并翻译，生成一张英文被中文替换的新图片，可保存或复制"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,6,0,16" />

                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="12,10"
                                        BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="10,4"
                                                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                                            <TextBlock x:Name="ImageModifierKeyText" Text="Ctrl" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                        <TextBlock Text=" + " FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="8,0" />
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="10,4"
                                                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                                            <TextBlock x:Name="ImageMainKeyText" Text="F11" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                        <TextBlock Text="框选要翻译的区域" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                    <Button x:Name="ImageStartButton" Content="开始使用" FontSize="14" FontWeight="SemiBold"
                                            Padding="26,9" Background="{DynamicResource AccentBrush}" Foreground="White"
                                            BorderThickness="0" Cursor="Hand" Click="OnImageStartClick" />
                                    <Button x:Name="ImageEndButton" Content="结束" FontSize="13" Margin="12,0,0,0"
                                            Padding="22,9" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                                            Cursor="Hand" Visibility="Collapsed" Click="OnImageEndClick" />
                                </StackPanel>

                                <TextBlock x:Name="ImageStatusText"
                                           Text="点击「开始使用」后，按 Ctrl+F11 框选屏幕上的英文区域生成翻译图片"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,14,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 划词翻译页 -->
            <Grid x:Name="SelectionTranslateView" Margin="44,36" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="划词翻译" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="选中一段英文，按下快捷键即可在鼠标附近弹出中文译文"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="560">
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="24,22"
                                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="划词翻译" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="先选中英文文本，再按快捷键，自动抓取选中内容并翻译为中文"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,6,0,16" />

                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="12,10"
                                        BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="10,4"
                                                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                                            <TextBlock x:Name="SelectionModifierKeyText" Text="Ctrl" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                        <TextBlock Text=" + " FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="8,0" />
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="10,4"
                                                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                                            <TextBlock x:Name="SelectionMainKeyText" Text="F12" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                        <TextBlock Text="翻译选中的文本" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                    <Button x:Name="SelectionStartButton" Content="开始使用" FontSize="14" FontWeight="SemiBold"
                                            Padding="26,9" Background="{DynamicResource AccentBrush}" Foreground="White"
                                            BorderThickness="0" Cursor="Hand" Click="OnSelectionStartClick" />
                                    <Button x:Name="SelectionEndButton" Content="结束" FontSize="13" Margin="12,0,0,0"
                                            Padding="22,9" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                                            Cursor="Hand" Visibility="Collapsed" Click="OnSelectionEndClick" />
                                </StackPanel>

                                <TextBlock x:Name="SelectionStatusText"
                                           Text="点击「开始使用」后，选中英文并按 Ctrl+F12 划词翻译"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,14,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 设置页 -->
            <Grid x:Name="SettingsView" Margin="44,36" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="720" Margin="0,0,0,24">
                        <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="管理屏幕翻译相关选项"
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,24" />

                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="24,22"
                                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="屏幕翻译快捷键" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="点击「开始使用」后，按下组合键框选要翻译的区域"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,6,0,20" />

                                <TextBlock Text="修饰键（可多选，至少一个）" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,18">
                                    <CheckBox x:Name="CtrlCheck" Content="Ctrl" FontSize="14" />
                                    <CheckBox x:Name="AltCheck" Content="Alt" FontSize="14" Margin="28,0,0,0" />
                                    <CheckBox x:Name="ShiftCheck" Content="Shift" FontSize="14" Margin="28,0,0,0" />
                                    <CheckBox x:Name="WinCheck" Content="Win" FontSize="14" Margin="28,0,0,0" />
                                </StackPanel>

                                <TextBlock Text="按键（点击下方输入框后按下字母 / 数字 / F1-F12）" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox x:Name="KeyBox" Width="200" HorizontalAlignment="Left"
                                         Margin="0,10,0,0" Padding="8,7" FontSize="14"
                                         IsReadOnly="True" Cursor="Hand"
                                         ToolTip="点击后按下要使用的按键"
                                         GotKeyboardFocus="OnKeyBoxFocused"
                                         PreviewKeyDown="OnKeyBoxKeyDown" />

                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="14,10"
                                        Margin="0,20,0,0"
                                        BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="当前组合：" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="PreviewText" Text="Ctrl + F10" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <Button Content="恢复默认（Ctrl + F10）" Padding="0,8" HorizontalAlignment="Left"
                                        Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                        BorderThickness="0" Cursor="Hand" Click="OnResetClick" />
                            </StackPanel>
                        </Border>

                    <!-- 图片翻译快捷键 -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="24,22"
                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="图片翻译快捷键" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="点击「开始使用」后，按下组合键框选区域，生成翻译图片"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,6,0,20" />

                            <TextBlock Text="修饰键（可多选，至少一个）" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,18">
                                <CheckBox x:Name="ImgCtrlCheck" Content="Ctrl" FontSize="14" />
                                <CheckBox x:Name="ImgAltCheck" Content="Alt" FontSize="14" Margin="28,0,0,0" />
                                <CheckBox x:Name="ImgShiftCheck" Content="Shift" FontSize="14" Margin="28,0,0,0" />
                                <CheckBox x:Name="ImgWinCheck" Content="Win" FontSize="14" Margin="28,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="按键（点击下方输入框后按下字母 / 数字 / F1-F12）" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="ImgKeyBox" Width="200" HorizontalAlignment="Left"
                                     Margin="0,10,0,0" Padding="8,7" FontSize="14"
                                     IsReadOnly="True" Cursor="Hand"
                                     ToolTip="点击后按下要使用的按键"
                                     GotKeyboardFocus="OnImgKeyBoxFocused"
                                     PreviewKeyDown="OnImgKeyBoxKeyDown" />

                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="14,10"
                                    Margin="0,20,0,0"
                                    BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="当前组合：" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="ImgPreviewText" Text="Ctrl + F11" FontSize="14"
                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </Border>

                            <Button Content="恢复默认（Ctrl + F11）" Padding="0,8" HorizontalAlignment="Left"
                                    Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                    BorderThickness="0" Cursor="Hand" Click="OnImgResetClick" />
                        </StackPanel>
                    </Border>

                    <!-- 划词翻译快捷键 -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="24,22"
                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="划词翻译快捷键" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="点击「开始使用」后，选中文本按下组合键即可翻译"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,6,0,20" />

                            <TextBlock Text="修饰键（可多选，至少一个）" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,18">
                                <CheckBox x:Name="SelCtrlCheck" Content="Ctrl" FontSize="14" />
                                <CheckBox x:Name="SelAltCheck" Content="Alt" FontSize="14" Margin="28,0,0,0" />
                                <CheckBox x:Name="SelShiftCheck" Content="Shift" FontSize="14" Margin="28,0,0,0" />
                                <CheckBox x:Name="SelWinCheck" Content="Win" FontSize="14" Margin="28,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="按键（点击下方输入框后按下字母 / 数字 / F1-F12）" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="SelKeyBox" Width="200" HorizontalAlignment="Left"
                                     Margin="0,10,0,0" Padding="8,7" FontSize="14"
                                     IsReadOnly="True" Cursor="Hand"
                                     ToolTip="点击后按下要使用的按键"
                                     GotKeyboardFocus="OnSelKeyBoxFocused"
                                     PreviewKeyDown="OnSelKeyBoxKeyDown" />

                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="14,10"
                                    Margin="0,20,0,0"
                                    BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="当前组合：" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="SelPreviewText" Text="Ctrl + F12" FontSize="14"
                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </Border>

                            <Button Content="恢复默认（Ctrl + F12）" Padding="0,8" HorizontalAlignment="Left"
                                    Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                    BorderThickness="0" Cursor="Hand" Click="OnSelResetClick" />
                        </StackPanel>
                    </Border>

                    <!-- 应用主题 -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="24,22"
                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="应用主题" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="选择配色风格，保存后立即生效"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,6,0,20" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeLightRadio" Content="默认（浅色）" FontSize="14"
                                             Foreground="{DynamicResource TextPrimaryBrush}" />
                                <RadioButton x:Name="ThemeDarkRadio" Content="黑色" FontSize="14"
                                             Foreground="{DynamicResource TextPrimaryBrush}" Margin="28,0,0,0" />
                                <RadioButton x:Name="ThemeWarmRadio" Content="暖色" FontSize="14"
                                             Foreground="{DynamicResource TextPrimaryBrush}" Margin="28,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 开机自启动 -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="24,22"
                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="开机自启动" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text=""
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,6,0,20" TextWrapping="Wrap" />
                            <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" FontSize="14"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      Checked="OnAutoStartToggled" Unchecked="OnAutoStartToggled" />
                            <TextBlock x:Name="AutoStartStatusText" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
                            <CheckBox x:Name="DesktopShortcutCheck" Content="在桌面创建快捷方式" FontSize="14"
                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,18,0,0"
                                      Checked="OnDesktopShortcutToggled" Unchecked="OnDesktopShortcutToggled" />
                            <TextBlock x:Name="DesktopShortcutStatusText" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 自定义 DeepSeek API Key -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="24,22"
                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="DeepSeek API Key（可选）" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="图片翻译使用：识别图中英文并翻译成中文。每个账号可免费体验 15 次截图翻译（使用开发者预置 Key）；免费额度用尽后可填写你自己的 DeepSeek API Key 继续使用。"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,6,0,20" TextWrapping="Wrap" />
                            <TextBlock Text="自定义 DeepSeek API Key" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="UserApiKeyBox" Width="420" HorizontalAlignment="Left"
                                     Margin="0,10,0,0" Padding="8,7" FontSize="13"
                                     ToolTip="可在 https://platform.deepseek.com 获取；留空则使用免费体验额度" />
                            <TextBlock x:Name="FreeQuotaText" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 检查更新 -->
                    <Border x:Name="UpdateSectionPanel" Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="8" Padding="24,22"
                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="检查更新" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="更新会更新一下功能，和修复一下bug"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,6,0,20" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckUpdateButton" Content="检查更新" FontSize="14" FontWeight="SemiBold"
                                        Padding="26,9" Background="{DynamicResource AccentBrush}" Foreground="White"
                                        BorderThickness="0" Cursor="Hand" Click="OnCheckUpdateClick" />
                                <TextBlock x:Name="CurrentVersionText" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="16,0,0,0" />
                            </StackPanel>
                            <ProgressBar x:Name="UpdateProgressBar" Height="6" Margin="0,16,0,0"
                                         Maximum="1" Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource BorderBrushColor}" Visibility="Collapsed" />
                            <TextBlock x:Name="UpdateStatusText"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="UpdateResultText"
                                       FontSize="13" Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,8,0,0" TextWrapping="Wrap">
                                <TextBlock.Inlines>
                                    <Hyperlink x:Name="UpdateLink"
                                                RequestNavigate="OnUpdateLinkNavigate">查看详情</Hyperlink>
                                </TextBlock.Inlines>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 保存设置 -->
                    <Button Content="保存设置" Padding="30,11" Margin="0,24,0,0"
                            HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                            Background="{DynamicResource AccentBrush}" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="OnSaveSettingsClick" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
