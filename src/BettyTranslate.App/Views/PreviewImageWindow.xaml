<Window x:Class="BettyTranslate.App.Views.PreviewImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片翻译结果 — Betty Translate"
        Width="720" Height="540" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="图片翻译结果" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="4,0,0,12" />

        <!-- 原图预览 -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" />
            </ScrollViewer>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="复制到剪贴板" Padding="18,9" Foreground="{DynamicResource TextSecondaryBrush}"
                    Background="Transparent" BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="1" Cursor="Hand" Click="OnCopyClick" />
            <Button Content="保存图片…" Padding="22,9" Margin="12,0,0,0"
                    Background="{DynamicResource AccentBrush}" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
