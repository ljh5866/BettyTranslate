<Window x:Class="BettyTranslate.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Betty Translate - 登录"
        Width="380" Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Betty Translate"
                   FontSize="26" FontWeight="Bold" Foreground="#2B5CE6"
                   HorizontalAlignment="Center" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" Text="登录后即可使用屏幕翻译功能"
                   FontSize="13" Foreground="#888888"
                   HorizontalAlignment="Center" Margin="0,0,0,16" />

        <TabControl Grid.Row="2" BorderThickness="0" Background="Transparent">
            <TabItem Header="登录">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="邮箱" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Margin="0,0,0,14" FontSize="14" />

                    <TextBlock Text="密码" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordBox"
                                 Padding="8,6" Margin="0,0,0,10" FontSize="14" />

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#D32F2F"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" MinHeight="16" />
                    <TextBlock Text="{Binding Notice}" Foreground="#2E7D32"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" MinHeight="16" />

                    <Button Content="登录" Height="38" Margin="0,8,0,0"
                            FontSize="14" FontWeight="SemiBold" Foreground="White"
                            Background="#2B5CE6" Command="{Binding LoginCommand}" IsDefault="True" />
                </StackPanel>
            </TabItem>

            <TabItem Header="注册">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="邮箱" Margin="0,0,0,4" />
                    <TextBox x:Name="RegEmailBox"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Margin="0,0,0,14" FontSize="14" />

                    <TextBlock Text="密码（至少 6 位）" Margin="0,0,0,4" />
                    <PasswordBox x:Name="RegPasswordBox"
                                 Padding="8,6" Margin="0,0,0,14" FontSize="14" />

                    <TextBlock Text="验证码" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,10">
                        <Button Content="发送验证码" DockPanel.Dock="Right" Width="96"
                                Padding="0,6" Margin="8,0,0,0" Background="#E8EEFB"
                                Foreground="#2B5CE6" FontSize="12"
                                Command="{Binding SendCodeCommand}" />
                        <TextBox Text="{Binding VerificationCode, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="14"
                                 MaxLength="6" InputMethod.IsInputMethodEnabled="False" />
                    </DockPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#D32F2F"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" MinHeight="16" />
                    <TextBlock Text="{Binding Notice}" Foreground="#2E7D32"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" MinHeight="16" />

                    <Button Content="注册" Height="38" Margin="0,8,0,0"
                            FontSize="14" FontWeight="SemiBold" Foreground="White"
                            Background="#2B5CE6" Command="{Binding RegisterCommand}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
