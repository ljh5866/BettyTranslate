<Window x:Class="BettyTranslate.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Betty Translate - 登录"
        Width="380" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Betty Translate"
                   FontSize="26" FontWeight="Bold" Foreground="#2B5CE6"
                   HorizontalAlignment="Center" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" Text="登录后即可使用屏幕翻译功能"
                   FontSize="13" Foreground="#888888"
                   HorizontalAlignment="Center" Margin="0,0,0,24" />

        <TextBlock Grid.Row="2" Text="邮箱" Margin="0,0,0,4" />
        <TextBox Grid.Row="3" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                 Padding="8,6" Margin="0,0,0,14" FontSize="14" />

        <TextBlock Grid.Row="4" Text="密码" Margin="0,0,0,4" />
        <PasswordBox Grid.Row="5" x:Name="PasswordBox"
                     Padding="8,6" Margin="0,0,0,6" FontSize="14" />

        <TextBlock Grid.Row="6" Text="{Binding ErrorMessage}"
                   Foreground="#D32F2F" FontSize="12"
                   TextWrapping="Wrap" Margin="0,0,0,6" VerticalAlignment="Top" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom">
            <Button Content="登录" Width="140" Height="38" Margin="0,0,12,0"
                    FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#2B5CE6"
                    Command="{Binding LoginCommand}" IsDefault="True" />
            <Button Content="注册" Width="140" Height="38"
                    FontSize="14" Background="#EEEEEE" Foreground="#333333"
                    Command="{Binding RegisterCommand}" />
        </StackPanel>
    </Grid>
</Window>
