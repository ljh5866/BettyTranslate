<Window x:Class="BettyTranslate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Betty Translate" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock Text="Betty Translate"
                       FontSize="20" FontWeight="Bold" Foreground="#2B5CE6"
                       VerticalAlignment="Center" />
            <Button Content="退出登录" DockPanel.Dock="Right"
                    Padding="12,4" Background="#EEEEEE" Foreground="#333333"
                    Click="OnLogoutClick" />
            <TextBlock x:Name="UserText" DockPanel.Dock="Right"
                       Text="{x:Null}" Margin="0,0,16,0" Foreground="#666666"
                       VerticalAlignment="Center" />
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Margin="0,16,0,0"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="屏幕翻译功能开发中（M2 里程碑）"
                           FontSize="16" Foreground="#888888" HorizontalAlignment="Center" />
                <TextBlock Text="按快捷键后将询问是否进行屏幕翻译并扫描翻译"
                           FontSize="13" Foreground="#AAAAAA" Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
