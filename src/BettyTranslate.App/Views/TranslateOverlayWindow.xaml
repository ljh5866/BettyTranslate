<Window x:Class="BettyTranslate.App.Views.TranslateOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏幕翻译"
        Width="560" Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize">
    <Border CornerRadius="8" Background="#E6212229" BorderBrush="#552B5CE6" BorderThickness="1">
        <DockPanel Margin="14">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="✕" Width="26" Height="26"
                        Background="Transparent" BorderThickness="0" Foreground="#9AA0B0"
                        FontSize="14" Cursor="Hand" Click="OnCloseClick" />
                <TextBlock x:Name="StatusText" Text="屏幕翻译" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" Foreground="#9AA0B0" />
            </DockPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LineList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding Source}" Foreground="#9AA0B0"
                                           TextWrapping="Wrap" FontSize="12" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding Translation}" Foreground="White"
                                           TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
