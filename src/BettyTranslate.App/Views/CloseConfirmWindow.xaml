<Window x:Class="BettyTranslate.App.Views.CloseConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
    <Border CornerRadius="14" Background="#FFFFFF"
            BorderBrush="#CFCFCF" BorderThickness="1"
            MinWidth="420" MaxWidth="460">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.28" Color="#101010" />
        </Border.Effect>
        <StackPanel>
            <!-- 顶部醒目横幅：蓝色渐变 + 图标 + 标题 -->
            <Border Height="50" CornerRadius="14,14,0,0" Padding="20,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0F6CBD" Offset="0" />
                        <GradientStop Color="#2B87E0" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/AppIcon.ico" Width="22" Height="22"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Betty Translate" FontSize="15" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="关闭确认" FontSize="12" Foreground="#D6E9FB"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 主体区域 -->
            <Border Padding="24,20,24,22">
                <StackPanel>
                <TextBlock Text="要退出程序，还是隐藏到电脑扩展栏？" FontSize="15" FontWeight="Bold"
                           Foreground="#1B1B1B" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock Text="隐藏后翻译功能仍可正常使用，双击托盘图标可恢复主界面。"
                           FontSize="12.5" Foreground="#616161" TextWrapping="Wrap" Margin="0,0,0,20" />

                <!-- 按钮区：隐藏=亮蓝，退出=警示红 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="HideButton" IsDefault="True" IsCancel="True" Click="OnHideClick"
                            Height="36" MinWidth="140" Padding="16,0" Margin="0,0,10,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#0F6CBD" CornerRadius="7"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#0B5AA5" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#094A8A" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="隐藏到电脑扩展栏" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                    </Button>

                    <Button x:Name="ExitButton" Click="OnExitClick"
                            Height="36" MinWidth="120" Padding="16,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#C8352B" CornerRadius="7"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#A82A21" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#8E241D" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="退出程序" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
