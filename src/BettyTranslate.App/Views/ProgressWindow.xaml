<Window x:Class="BettyTranslate.App.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" FontFamily="Segoe UI">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="24,18"
            BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
            MinWidth="280" MaxWidth="420">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="18" Height="18" IsIndeterminate="True" Margin="0,0,10,0"
                             Foreground="{DynamicResource AccentBrush}" />
                <TextBlock x:Name="MessageText" Text="正在处理…" FontSize="14"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
