<Window x:Class="BettyTranslate.App.Views.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择翻译区域"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" Cursor="Cross"
        PreviewKeyDown="OnPreviewKeyDown">
    <Canvas x:Name="RootCanvas" Background="Transparent">
        <Rectangle x:Name="DimLayer" Fill="#66000000" />
        <Rectangle x:Name="SelectionRect" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                   Fill="Transparent" Visibility="Collapsed" />
        <Border x:Name="HintBox" Background="#E6222222" CornerRadius="6" Padding="12,6">
            <TextBlock Text="拖拽选择要翻译的区域，ESC 取消"
                       Foreground="White" FontSize="13" />
        </Border>
    </Canvas>
</Window>
