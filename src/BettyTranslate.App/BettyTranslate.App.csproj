<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\BettyTranslate.Core\BettyTranslate.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041.0 闂備礁鎲￠崙褰掑垂閹惰棄鏋?WinRT API闂備焦瀵х粙鎴炵附閺冨倻绠?Core 濠电儑绲藉ú锔炬崲閸愵亖鍋撻崹顐ｂ拹缂佸顦甸崺鈧い鎺戝閸?-->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.5.7</Version>
    <InformationalVersion>0.5.7-build20260828</InformationalVersion>
    <!-- exe 闂備礁鎼崐绋棵洪敐鍛瀻闁靛繈鍊曢悙濠囨煟閹伴潧澧伴柛?-->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Config\appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>
</Project>