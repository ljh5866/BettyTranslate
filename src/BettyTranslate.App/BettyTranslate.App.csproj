<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\BettyTranslate.Core\BettyTranslate.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041.0 闂佸憡鍑归崹鎶藉极?WinRT API闂佹寧绋戞總鏃傜箔?Core 婵烇絽娲︾换鍐偓鍨⒐缁嬪鍩€椤掑嫭鍤?-->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.5.6</Version>
    <InformationalVersion>0.5.6-build20260828</InformationalVersion>
    <!-- exe 闂佸搫鍊稿ú锝呪枎閵忋倕鐐婇柣鎰靛墰閸?-->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Config\appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>
</Project>