<Application x:Class="BettyTranslate.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- 全局统一字体（Fluent / Segoe UI） -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="Control">
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <!-- 统一色板（浅色 Fluent） -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0B5AA5" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F0FA" />
        <SolidColorBrush x:Key="AccentBorderBrush" Color="#D0E2F5" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#D8E6F5" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#616161" />
        <SolidColorBrush x:Key="BorderBrushColor" Color="#E0E0E0" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BgBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="NavHoverBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="NavPressedBrush" Color="#E5E5E5" />
        <SolidColorBrush x:Key="BottomHoverBrush" Color="#E9E9E9" />
        <SolidColorBrush x:Key="BottomPressedBrush" Color="#E0E0E0" />
    </Application.Resources>
</Application>
